{
  "name": "grand-cms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "opennextjs-cloudflare dev",
    "build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "postinstall": "prisma generate",
    "db:sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "latest",
    "@prisma/adapter-d1": "^6.16.0",
    "@prisma/client": "^6.16.0",
    "docx": "^9.5.1",
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "prisma": "^6.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "wrangler": "latest"
  }
}